{
    "name": "ssionn/github-forge-laravel",
    "description": "A GitHub REST API client for Laravel",
    "type": "library",
    "require": {
        "php": "^8.4",
        "illuminate/http": "*",
        "illuminate/support": "*",
        "illuminate/pagination": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Ssionn\\GithubForgeLaravel\\": "src/",
            "Tests\\": "tests/"
        },
        "files": [
            "helpers.php"
        ]
    },
    "authors": [
        {
            "name": "Ssionn",
            "email": "casperkizewski@outlook.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ssionn\\GithubForgeLaravel\\GithubForgeServiceProvider"
            ],
            "aliases": {
                "GithubForge": "Ssionn\\GithubForgeLaravel\\Facades\\GithubForge"
            }
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "pestphp/pest": "^3.8",
        "orchestra/testbench": "^10.4",
        "pestphp/pest-plugin-laravel": "^3.2"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
